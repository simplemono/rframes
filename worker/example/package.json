{
  "name": "rframes-worker-example",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "vite build --config vite.worker.config.mjs && vite build --config vite.client.config.mjs",
